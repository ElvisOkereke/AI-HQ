# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database

# Authentication
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000
GITHUB_ID=your-github-oauth-client-id
GITHUB_SECRET=your-github-oauth-client-secret

# AI Provider (FuelIX gateway - the only app-hosted provider)
FUELIX_API_KEY=your-fuelix-api-key
# Optional, defaults to https://api.fuelix.ai/v1
# FUELIX_BASE_URL=https://api.fuelix.ai/v1

# BYOK (bring-your-own-key) encryption — used to encrypt user-saved API keys at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key
